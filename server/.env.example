# Re:Earth CMS server — copy to server/.env
# Local development needs only the REQUIRED section. See the onboarding guide.
# No secrets needed with Dex. Exported shell variables override this file.

# ---------- REQUIRED FOR LOCAL DEVELOPMENT ----------

# Accounts service. Use your LOCAL reearth-accounts (must match its port).
REEARTH_CMS_ACCOUNT_API_ENABLED=true
REEARTH_CMS_ACCOUNT_API_HOST=http://localhost:8090

# Local Dex login (make run-dex). Must match Accounts and web.
REEARTH_CMS_AUTH_ISS=http://localhost:5556/dex
REEARTH_CMS_AUTH_AUD=cms-local
REEARTH_CMS_AUTH_JWKSURI=http://localhost:5556/dex/keys

# Tracing (on by default). Disable if you don't run a local collector.
REEARTH_CMS_OTEL_ENABLED=false

# ---------- AUTH0 (alternative to Dex) ----------

# Must match Accounts and web. Source: 1Password
# REEARTH_CMS_AUTH0_DOMAIN=
# REEARTH_CMS_AUTH0_AUDIENCE=
# App credentials, for management calls only. Source: 1Password
# REEARTH_CMS_AUTH0_CLIENTID=
# REEARTH_CMS_AUTH0_CLIENTSECRET=
# REEARTH_CMS_AUTH0_WEBCLIENTID=

# ---------- DATABASE (defaults work locally) ----------

# Same MongoDB instance as Accounts
REEARTH_CMS_DB=mongodb://localhost
# Must match REEARTH_ACCOUNTS_DB_NAME (Accounts)
REEARTH_CMS_DB_ACCOUNT=reearth_account
REEARTH_CMS_DB_CMS=reearth_cms
# REEARTH_CMS_DB_USERS=Test1=mongodb://localhost,Test2=mongodb://localhost

# ---------- OPTIONAL LOCALLY ----------

# Accounts API timeout in seconds (default 30)
# REEARTH_CMS_ACCOUNT_API_TIMEOUT=30
# Permission checks via Accounts/Cerbos (default false)
# REEARTH_CMS_ACCOUNT_API_CHECK_PERMISSION=false

# Protects POST /api/signup (empty = open)
# REEARTH_CMS_SIGNUPSECRET=

# Tracing settings (local Jaeger: docker compose up -d reearth-cms-jaeger)
# REEARTH_CMS_OTEL_ENDPOINT=http://localhost:4318
# REEARTH_CMS_OTEL_SAMPLINGRATIO=1.0
# REEARTH_CMS_OTEL_MAXEXPORTBATCHSIZE=
# REEARTH_CMS_OTEL_BATCHTIMEOUT=
# REEARTH_CMS_OTEL_MAXQUEUESIZE=

# ---------- GENERAL (defaults work locally) ----------

# PORT=8080
# REEARTH_CMS_HOST=http://localhost:8080
# REEARTH_CMS_SERVERHOST=localhost
# REEARTH_CMS_HOST_WEB=http://localhost:3000
# Enabled automatically by `make run-app`
# REEARTH_CMS_DEV=false

# CORS (not needed locally: dev mode allows all origins)
# REEARTH_CMS_ORIGINS=www.example.com,localhost:3000
# REEARTH_CMS_INTEGRATION_ORIGINS=*
# REEARTH_CMS_PUBLIC_ORIGINS=*

# Public posting endpoint rate limiting
# REEARTH_CMS_PUBLIC_RATELIMIT_RATEPERMINUTE=100
# REEARTH_CMS_PUBLIC_RATELIMIT_BURST=100
# REEARTH_CMS_PUBLIC_RATELIMIT_EXPIRESIN=1m

# REEARTH_CMS_GRAPHQL_COMPLEXITYLIMIT=6000
# REEARTH_CMS_SERVER_ACTIVE=true

# Policy checker: permissive (default) or http (requires ENDPOINT)
# REEARTH_CMS_POLICY_CHECKER_TYPE=permissive
# REEARTH_CMS_POLICY_CHECKER_ENDPOINT=
# REEARTH_CMS_POLICY_CHECKER_TOKEN=
# REEARTH_CMS_POLICY_CHECKER_TIMEOUT=30

# ---------- DEPLOYED ENVIRONMENTS ONLY ----------

# Internal gRPC API
# REEARTH_CMS_INTERNALAPI_ACTIVE=false
# REEARTH_CMS_INTERNALAPI_PORT=50051
# REEARTH_CMS_INTERNALAPI_TOKEN=

# Mail: log (default), smtp, sendgrid
# REEARTH_CMS_SMTP_HOST=
# REEARTH_CMS_SMTP_PORT=587
# REEARTH_CMS_SMTP_SMTPUSERNAME=
# REEARTH_CMS_SMTP_EMAIL=
# REEARTH_CMS_SMTP_PASSWORD=
# REEARTH_CMS_SENDGRID_EMAIL=
# REEARTH_CMS_SENDGRID_NAME=
# REEARTH_CMS_SENDGRID_API=

# Storage (empty bucket = local files)
# REEARTH_CMS_GCS_BUCKETNAME=
# REEARTH_CMS_GCS_PUBLICATIONCACHECONTROL=public,max-age=31536000
# REEARTH_CMS_ASSETBASEURL=http://localhost:8080
# GCS only: true = public bucket URLs, false = served via authenticated API
# REEARTH_CMS_ASSET_PUBLIC=true

# Generic JWT auth extras (ISS/AUD/JWKSURI are set above for Dex)
# REEARTH_CMS_AUTH_ALG=RS256
# REEARTH_CMS_AUTH_TTL=3600
# REEARTH_CMS_AUTH_CLIENTID=
# Multiple auth servers (JSON)
# REEARTH_CMS_AUTH=[{"ISS":"https://example.com","AUD":["https://api.example.com"]}]

# Machine-to-machine auth; ALG, TTL, JWKSURI optional
# REEARTH_CMS_AUTHM2M_ISS=
# REEARTH_CMS_AUTHM2M_AUD=
# REEARTH_CMS_AUTHM2M_EMAIL=
# REEARTH_CMS_AUTHM2M_ALG=RS256
# REEARTH_CMS_AUTHM2M_TTL=3600
# REEARTH_CMS_AUTHM2M_JWKSURI=

# Cognito
# REEARTH_CMS_COGNITO_USERPOOLID=
# REEARTH_CMS_COGNITO_REGION=
# REEARTH_CMS_COGNITO_CLIENTID=

# Firebase
# REEARTH_CMS_FIREBASE_PROJECTID=
# REEARTH_CMS_FIREBASE_CLIENTID=

# GCP task runner
# REEARTH_CMS_TASK_GCPPROJECT=
# REEARTH_CMS_TASK_GCPREGION=
# REEARTH_CMS_TASK_TOPIC=
# REEARTH_CMS_TASK_GCSHOST=
# REEARTH_CMS_TASK_GCSBUCKET=
# REEARTH_CMS_TASK_DECOMPRESSORIMAGE=
# REEARTH_CMS_TASK_DECOMPRESSORTOPIC=
# REEARTH_CMS_TASK_DECOMPRESSORGZIPEXT=
# REEARTH_CMS_TASK_DECOMPRESSORMACHINETYPE=
# REEARTH_CMS_TASK_COPIERIMAGE=
# REEARTH_CMS_TASK_DBSECRETNAME=
# REEARTH_CMS_TASK_CMSIMAGE=
# REEARTH_CMS_TASK_BUILDSERVICEACCOUNT=
# REEARTH_CMS_TASK_WORKERURL=

# Web client config as JSON (values are PUBLIC)
# REEARTH_CMS_WEB={"foo":"bar"}
# REEARTH_CMS_WEB_DISABLED=false

# Health check
# REEARTH_CMS_HEALTHCHECK_USERNAME=
# REEARTH_CMS_HEALTHCHECK_PASSWORD=
# REEARTH_CMS_HEALTHCHECK_RUNONINIT=
