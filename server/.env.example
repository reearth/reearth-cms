# Re:Earth CMS server — copy to server/.env
# Everything needed for local development with Dex. No secrets needed.
# All other variables (deployed environments, advanced settings): .env.reference
# Exported shell variables override this file.

# Accounts service. Use your LOCAL reearth-accounts (must match its port).
REEARTH_CMS_ACCOUNT_API_ENABLED=true
REEARTH_CMS_ACCOUNT_API_HOST=http://localhost:8090

# Local Dex login (make run-dex). Must match Accounts and web.
REEARTH_CMS_AUTH_ISS=http://localhost:5556/dex
REEARTH_CMS_AUTH_AUD=cms-local
REEARTH_CMS_AUTH_JWKSURI=http://localhost:5556/dex/keys

# Tracing is on by default. Disable it, or run Jaeger:
# docker compose up -d reearth-cms-jaeger
REEARTH_CMS_OTEL_ENABLED=false

# Database (defaults shown). Same MongoDB instance as Accounts.
# REEARTH_CMS_DB=mongodb://localhost
# Must match REEARTH_ACCOUNTS_DB_NAME (Accounts)
# REEARTH_CMS_DB_ACCOUNT=reearth_account
# REEARTH_CMS_DB_CMS=reearth_cms

# ---------- Auth0 instead of Dex ----------
# Must match Accounts and web. Source: 1Password
# REEARTH_CMS_AUTH0_DOMAIN=
# REEARTH_CMS_AUTH0_AUDIENCE=
# App credentials, for management calls only. Source: 1Password
# REEARTH_CMS_AUTH0_CLIENTID=
# REEARTH_CMS_AUTH0_CLIENTSECRET=
# REEARTH_CMS_AUTH0_WEBCLIENTID=
