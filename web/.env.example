# Re:Earth CMS web — copy to web/.env
# Local development with Dex needs only the first section. No secrets needed.

# ---------- LOCAL DEVELOPMENT (Dex, see server: make run-dex) ----------

# Must match the server's REEARTH_CMS_AUTH_ISS / REEARTH_CMS_AUTH_AUD
REEARTH_CMS_AUTH_PROVIDER=oidc
REEARTH_CMS_OIDC_AUTHORITY=http://localhost:5556/dex
REEARTH_CMS_OIDC_CLIENT_ID=cms-local

# CMS API. The dev server defaults to http://localhost:8080/api
# REEARTH_CMS_API=http://localhost:8080/api

# ---------- OIDC OPTIONS ----------

# REEARTH_CMS_OIDC_SCOPE="openid profile email offline_access"
# Sent as `audience` on the authorize request (providers that need it)
# REEARTH_CMS_OIDC_AUDIENCE=
# id_token (default) or access_token
# REEARTH_CMS_OIDC_TOKEN_TYPE=id_token

# ---------- AUTH0 (instead of Dex) ----------

# Set REEARTH_CMS_AUTH_PROVIDER=auth0 (or remove it; auth0 is the default)
# Must match the server and Accounts. Source: 1Password
# REEARTH_CMS_AUTH0_DOMAIN=
# REEARTH_CMS_AUTH0_AUDIENCE=
# Web Auth0 app client ID (not a secret)
# REEARTH_CMS_AUTH0_CLIENT_ID=

# ---------- FIREBASE (only if AUTH_PROVIDER=firebase) ----------

# REEARTH_CMS_FIREBASE_API_KEY=
# REEARTH_CMS_FIREBASE_AUTH_DOMAIN=
# REEARTH_CMS_FIREBASE_PROJECT_ID=
# REEARTH_CMS_FIREBASE_STORAGE_BUCKET=
# REEARTH_CMS_FIREBASE_MESSAGING_SENDER_ID=
# REEARTH_CMS_FIREBASE_APP_ID=

# ---------- MAP AND SAAS UI (defaults shown) ----------

# Map tiles and terrain (token may be needed for map display)
# REEARTH_CMS_TILES_URL=https://tiles.reearth.land
# REEARTH_CMS_TERRAIN_URL=https://terrain.reearth.land
# REEARTH_CMS_TILES_TOKEN=
# REEARTH_CMS_DISABLE_WORKSPACE_UI=
# REEARTH_CMS_DASHBOARD_BASE_URL=https://reearth.io/
# REEARTH_CMS_VISUALIZER_BASE_URL=https://visualizer.reearth.io/

# ---------- E2E TESTS ONLY ----------

# REEARTH_CMS_E2E_USERNAME=
# REEARTH_CMS_E2E_PASSWORD=
# REEARTH_CMS_E2E_BASEURL=

# IAP auth (auto-detected for dev/staging vs localhost/production if unset)
# USE_IAP_AUTH=
# adc, service-account, or id-token
# IAP_AUTH_METHOD=
# OAuth client ID for the IAP-protected resource
# IAP_TARGET_AUDIENCE=
# Service account credentials (service-account method)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# ID token (id-token method)
# IAP_ID_TOKEN=
