{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>reearth/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Actions are pinned by .github/workflows/actions.lock, which Renovate regenerates; keep readable version tags in workflows",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": false
    },
    {
      "matchPackageNames": [
        "go.mongodb.org/mongo-driver"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Upgrade the Go toolchain (go.mod directive + golang images) in one PR",
      "matchDatasources": [
        "golang-version",
        "docker"
      ],
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain"
    },
    {
      "description": "Take go.mod go directives from the golang Docker image tags so they never get ahead of the images",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "overrideDatasource": "docker",
      "overridePackageName": "golang"
    }
  ]
}
