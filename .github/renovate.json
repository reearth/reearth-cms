{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>reearth/renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "go.mongodb.org/mongo-driver"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Upgrade the Go toolchain (go.mod directive + golang images) in one PR",
      "matchDatasources": [
        "golang-version",
        "docker"
      ],
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain"
    }
  ]
}
